# .env.dev - SOLO DESARROLLO LOCAL - NO usar en produccion
APP_NAME=Flipbook SaaS
DEBUG=True
API_VERSION=v1
ENVIRONMENT=development

DATABASE_URL=postgresql://flipbook:dev_password_local@postgres:5432/flipbook
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=flipbook_admin
MINIO_SECRET_KEY=dev_minio_s3_password
MINIO_SECURE=False
MINIO_BUCKET_PREFIX=tenant-

JWT_SECRET_KEY=dev-only-secret-key-change-in-prod-never-use-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000
