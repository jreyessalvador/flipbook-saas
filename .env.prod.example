# /srv/apps/flipbook/.env (PRODUCCION). chmod 600. Secretos propios, nunca los de DEV.
POSTGRES_DB=flipbook
POSTGRES_USER=flipbook
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
JWT_SECRET_KEY=
CORS_ORIGINS=https://revistas.cetrix.com.mx
VITE_API_URL=https://revistas.cetrix.com.mx

# --- Correo (L9) -- buzon IONOS no-reply@cetrix.com.mx. Contraseña SOLO en el .env del servidor.
SMTP_HOST=smtp.ionos.mx
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=no-reply@cetrix.com.mx
SMTP_PASSWORD=
MAIL_FROM=Cetrix Revistas <no-reply@cetrix.com.mx>
MAIL_REPLY_TO=
MAIL_DRY_RUN=false
APP_PUBLIC_URL=https://revistas.cetrix.com.mx
