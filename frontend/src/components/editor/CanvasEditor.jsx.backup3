import React, { useState, useEffect, useRef } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { fabric } from 'fabric';
import { publicationAPI } from '../../services/publicationAPI';
import { pageAPI } from '../../services/pageAPI';
import '../../styles/CanvasEditor.css';

const CanvasEditor = () => {
  const { id, pageId } = useParams();
  const navigate = useNavigate();
  const leftCanvasRef = useRef(null);
  const rightCanvasRef = useRef(null);
  const leftFabricCanvasRef = useRef(null);
  const rightFabricCanvasRef = useRef(null);

  const [publication, setPublication] = useState(null);
  const [pages, setPages] = useState([]);
  const [currentSpreadIndex, setCurrentSpreadIndex] = useState(0);
  const [activeTool, setActiveTool] = useState(null);
  const [selectedObject, setSelectedObject] = useState(null);
  const [activeCanvas, setActiveCanvas] = useState('left');
  const [loading, setLoading] = useState(true);

  // Calcular spreads (páginas enfrentadas)
  const getSpread = (index) => {
    if (index === 0) {
      // Portada sola
      return { left: null, right: pages[0] };
    } else if (index === pages.length - 1 && pages[pages.length - 1].page_type === 'back_cover') {
      // Contraportada sola
      return { left: pages[pages.length - 1], right: null };
    } else {
      // Páginas enfrentadas (índice par = izquierda, impar = derecha)
      const leftIndex = index * 2 - 1;
      const rightIndex = index * 2;
      return {
        left: pages[leftIndex] || null,
        right: pages[rightIndex] || null
      };
    }
  };

  const getCurrentSpread = () => getSpread(currentSpreadIndex);
  const totalSpreads = Math.ceil((pages.length - 1) / 2) + 1;

  useEffect(() => {
    loadPublication();
    loadPages();
  }, [id]);

  useEffect(() => {
    if (publication && pages.length > 0) {
      if (pageId) {
        const pageIndex = pages.findIndex(p => p.id === pageId);
        if (pageIndex !== -1) {
          const page = pages[pageIndex];
          if (page.page_type === 'cover') {
            setCurrentSpreadIndex(0);
          } else if (page.page_type === 'back_cover') {
            setCurrentSpreadIndex(totalSpreads - 1);
          } else {
            const spreadIdx = Math.floor((pageIndex) / 2);
            setCurrentSpreadIndex(spreadIdx);
          }
        }
      } else {
        setCurrentSpreadIndex(0);
      }
    }
  }, [pageId, pages, publication]);

  useEffect(() => {
    if (publication && pages.length > 0) {
      const spread = getCurrentSpread();
      initCanvases(spread);
    }
  }, [publication, pages, currentSpreadIndex]);

  const loadPublication = async () => {
    try {
      const data = await publicationAPI.get(id);
      setPublication(data);
    } catch (err) {
      console.error('Error loading publication:', err);
    }
  };

  const loadPages = async () => {
    try {
      setLoading(true);
      const data = await pageAPI.getPublicationPages(id);
      setPages(data);
    } catch (err) {
      console.error('Error loading pages:', err);
    } finally {
      setLoading(false);
    }
  };

  const initCanvases = (spread) => {
    if (!publication) return;

    const pixelWidth = publication.page_width * 3.78;
    const pixelHeight = publication.page_height * 3.78;

    // Canvas izquierdo
    if (spread.left && leftCanvasRef.current) {
      if (leftFabricCanvasRef.current) {
        leftFabricCanvasRef.current.dispose();
      }

      const leftCanvas = new fabric.Canvas(leftCanvasRef.current, {
        width: pixelWidth,
        height: pixelHeight,
        backgroundColor: '#ffffff',
      });

      leftFabricCanvasRef.current = leftCanvas;

      if (spread.left.content && Object.keys(spread.left.content).length > 0) {
        leftCanvas.loadFromJSON(spread.left.content, () => {
          leftCanvas.renderAll();
        });
      }

      leftCanvas.on('selection:created', (e) => {
        setActiveCanvas('left');
        setSelectedObject(e.selected[0]);
      });

      leftCanvas.on('selection:updated', (e) => {
        setActiveCanvas('left');
        setSelectedObject(e.selected[0]);
      });

      leftCanvas.on('selection:cleared', () => {
        setSelectedObject(null);
      });
    }

    // Canvas derecho
    if (spread.right && rightCanvasRef.current) {
      if (rightFabricCanvasRef.current) {
        rightFabricCanvasRef.current.dispose();
      }

      const rightCanvas = new fabric.Canvas(rightCanvasRef.current, {
        width: pixelWidth,
        height: pixelHeight,
        backgroundColor: '#ffffff',
      });

      rightFabricCanvasRef.current = rightCanvas;

      if (spread.right.content && Object.keys(spread.right.content).length > 0) {
        rightCanvas.loadFromJSON(spread.right.content, () => {
          rightCanvas.renderAll();
        });
      }

      rightCanvas.on('selection:created', (e) => {
        setActiveCanvas('right');
        setSelectedObject(e.selected[0]);
      });

      rightCanvas.on('selection:updated', (e) => {
        setActiveCanvas('right');
        setSelectedObject(e.selected[0]);
      });

      rightCanvas.on('selection:cleared', () => {
        setSelectedObject(null);
      });
    }
  };

  const getActiveCanvas = () => {
    return activeCanvas === 'left' ? leftFabricCanvasRef.current : rightFabricCanvasRef.current;
  };

  const addText = () => {
    const canvas = getActiveCanvas();
    if (!canvas) return;

    const text = new fabric.IText('Haz doble clic para editar', {
      left: 100,
      top: 100,
      fontSize: 24,
      fontFamily: 'Arial',
      fill: '#000000',
    });

    canvas.add(text);
    canvas.setActiveObject(text);
    setActiveTool(null);
  };

  const addRectangle = () => {
    const canvas = getActiveCanvas();
    if (!canvas) return;

    const rect = new fabric.Rect({
      left: 100,
      top: 100,
      width: 200,
      height: 150,
      fill: '#667eea',
      stroke: '#5568d3',
      strokeWidth: 2,
    });

    canvas.add(rect);
    canvas.setActiveObject(rect);
    setActiveTool(null);
  };

  const addCircle = () => {
    const canvas = getActiveCanvas();
    if (!canvas) return;

    const circle = new fabric.Circle({
      left: 100,
      top: 100,
      radius: 75,
      fill: '#764ba2',
      stroke: '#667eea',
      strokeWidth: 2,
    });

    canvas.add(circle);
    canvas.setActiveObject(circle);
    setActiveTool(null);
  };

  const deleteSelected = () => {
    const canvas = getActiveCanvas();
    if (!canvas) return;
    
    const activeObject = canvas.getActiveObject();
    if (activeObject) {
      canvas.remove(activeObject);
      setSelectedObject(null);
    }
  };

  const bringToFront = () => {
    const canvas = getActiveCanvas();
    if (!canvas || !selectedObject) return;
    
    canvas.bringToFront(selectedObject);
    canvas.renderAll();
  };

  const sendToBack = () => {
    const canvas = getActiveCanvas();
    if (!canvas || !selectedObject) return;
    
    canvas.sendToBack(selectedObject);
    canvas.renderAll();
  };

  const saveContent = async () => {
    const spread = getCurrentSpread();
    
    try {
      if (spread.left && leftFabricCanvasRef.current) {
        const leftContent = leftFabricCanvasRef.current.toJSON();
        await pageAPI.update(spread.left.id, { content: leftContent });
      }

      if (spread.right && rightFabricCanvasRef.current) {
        const rightContent = rightFabricCanvasRef.current.toJSON();
        await pageAPI.update(spread.right.id, { content: rightContent });
      }

      alert('✅ Contenido guardado correctamente');
    } catch (err) {
      console.error('Error saving content:', err);
      alert('❌ Error al guardar el contenido');
    }
  };

  const goToSpread = (index) => {
    if (index >= 0 && index < totalSpreads) {
      setCurrentSpreadIndex(index);
      setSelectedObject(null);
    }
  };

  const prevSpread = () => goToSpread(currentSpreadIndex - 1);
  const nextSpread = () => goToSpread(currentSpreadIndex + 1);

  if (loading) {
    return <div className="loading">Cargando editor...</div>;
  }

  if (!publication || pages.length === 0) {
    return <div className="loading">Preparando editor...</div>;
  }

  const spread = getCurrentSpread();
  const canGoPrev = currentSpreadIndex > 0;
  const canGoNext = currentSpreadIndex < totalSpreads - 1;

  return (
    <div className="canvas-editor-container">
      <div className="editor-header">
        <div className="header-left">
          <button onClick={() => navigate(`/publications/${id}/view`)} className="btn-back">
            ← Volver al Visor
          </button>
          <h2>{publication.title}</h2>
          <span className="page-info">
            {spread.left && spread.right 
              ? `Páginas ${spread.left.page_number}-${spread.right.page_number}`
              : spread.left 
                ? `Página ${spread.left.page_number}`
                : `Página ${spread.right.page_number}`
            }
          </span>
        </div>
        <div className="header-right">
          <button onClick={saveContent} className="btn-save">
            💾 Guardar
          </button>
        </div>
      </div>

      <div className="editor-sidebar">
        <div className="toolbar">
          <h3>HERRAMIENTAS</h3>

          <button onClick={addText} className="tool-btn">
            <span className="tool-icon">T</span>
            <span className="tool-label">Texto</span>
          </button>

          <button onClick={addRectangle} className="tool-btn">
            <span className="tool-icon">▭</span>
            <span className="tool-label">Rectángulo</span>
          </button>

          <button onClick={addCircle} className="tool-btn">
            <span className="tool-icon">●</span>
            <span className="tool-label">Círculo</span>
          </button>

          <hr />

          {selectedObject && (
            <>
              <h3>CAPAS</h3>
              <button onClick={bringToFront} className="tool-btn">
                <span className="tool-icon">↑</span>
                <span className="tool-label">Al frente</span>
              </button>

              <button onClick={sendToBack} className="tool-btn">
                <span className="tool-icon">↓</span>
                <span className="tool-label">Atrás</span>
              </button>

              <hr />

              <button onClick={deleteSelected} className="tool-btn tool-btn-danger">
                <span className="tool-icon">🗑️</span>
                <span className="tool-label">Eliminar</span>
              </button>
            </>
          )}
        </div>
      </div>

      <div className="editor-canvas-area">
        <div className="canvas-spread-wrapper">
          {spread.left && (
            <div className={`canvas-page ${activeCanvas === 'left' ? 'active' : ''}`}>
              <canvas ref={leftCanvasRef} id="fabric-canvas-left"></canvas>
              <div className="page-label">Pág. {spread.left.page_number}</div>
            </div>
          )}

          {spread.right && (
            <div className={`canvas-page ${activeCanvas === 'right' ? 'active' : ''}`}>
              <canvas ref={rightCanvasRef} id="fabric-canvas-right"></canvas>
              <div className="page-label">Pág. {spread.right.page_number}</div>
            </div>
          )}
        </div>

        <div className="canvas-nav-controls">
          <button onClick={prevSpread} disabled={!canGoPrev} className="btn-nav">
            ← Anterior
          </button>
          <span className="spread-info">
            Spread {currentSpreadIndex + 1} de {totalSpreads}
          </span>
          <button onClick={nextSpread} disabled={!canGoNext} className="btn-nav">
            Siguiente →
          </button>
        </div>
      </div>

      <div className="editor-pages-bar">
        {pages.map((page, index) => (
          <div
            key={page.id}
            className={`page-thumb ${
              (spread.left?.id === page.id || spread.right?.id === page.id) ? 'active' : ''
            }`}
            onClick={() => {
              if (page.page_type === 'cover') {
                goToSpread(0);
              } else if (page.page_type === 'back_cover') {
                goToSpread(totalSpreads - 1);
              } else {
                const spreadIdx = Math.floor((index) / 2);
                goToSpread(spreadIdx);
              }
            }}
          >
            <div className="thumb-number">{page.page_number}</div>
          </div>
        ))}
      </div>
    </div>
  );
};

export default CanvasEditor;
