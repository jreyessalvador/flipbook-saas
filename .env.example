# .env.example -- copiar a .env y rellenar con los valores REALES de tu
# entorno. .env nunca se comitea (ver .gitignore) -- es el UNICO lugar con
# valores especificos de un servidor concreto. Mover este proyecto a otro
# servidor = copiar la carpeta completa + editar este archivo (puertos,
# credenciales, IP donde se publican API/frontend).
#
# Ver RECETA-DESARROLLO.md seccion 4 y docker-compose.dev.yml.

POSTGRES_DB=flipbook
POSTGRES_USER=flipbook
POSTGRES_PASSWORD=change_me

MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change_me

JWT_SECRET_KEY=change-me-not-for-production

# Puertos de las bases de datos/servicios internos, publicados SOLO en
# 127.0.0.1 (nunca en 0.0.0.0/todas las interfaces) -- son para depurar
# desde el propio servidor con un cliente de BD, no para acceso remoto.
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389
MINIO_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011

# API y frontend: guardarrail -- publicar SOLO en la IP privada/Tailscale
# del servidor, nunca en 0.0.0.0 (ver projects/ia-lavatur/context.md en
# agents-memory). Formato: "ip:puerto" (docker-compose lo antepone al
# puerto del contenedor).
API_PORT=100.71.185.7:8010
FRONTEND_PORT=100.71.185.7:5173

# Origenes permitidos por CORS en el backend -- debe incluir de donde carga
# el frontend (ver arriba). Coma-separado.
CORS_ORIGINS=http://100.71.185.7:5173,http://localhost:5173

# URL que usa el frontend (Vite) para llamar a la API -- debe apuntar a la
# misma IP/puerto publicados arriba, nunca a localhost (el navegador no
# corre en este servidor).
VITE_API_URL=http://100.71.185.7:8010
